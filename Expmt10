import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Sample Data
data = {
    "Name": ["A", "B", "C", "D", "E"],
    "Marks": [85, 90, 78, 92, 88],
    "Age": [20, 21, 19, 22, 20]
}

df = pd.DataFrame(data)


# Line Plot

plt.figure()
plt.plot(df["Name"], df["Marks"], marker='o')
plt.title("Line Plot")
plt.show()

# Bar Chart

plt.figure()
plt.bar(df["Name"], df["Marks"])
plt.title("Bar Chart")
plt.show()

# Histogram

plt.figure()
plt.hist(df["Marks"], bins=5)
plt.title("Histogram")
plt.show()


# Scatter Plot

plt.figure()
plt.scatter(df["Age"], df["Marks"])
plt.title("Scatter Plot")
plt.show()

# Box Plot

plt.figure()
sns.boxplot(x=df["Marks"])
plt.title("Box Plot")
plt.show()

plt.figure()
sns.heatmap(df.corr(), annot=True)
plt.title("Heatmap")
plt.show()

